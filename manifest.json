{
  "manifest_version": 3,
  "name": "IPTracer - Modern IP & Network Inspector",
  "version": "2.0.0",
  "description": "Real-time client IP, geolocation, ISP/ASN telemetry, active tab domain tracing, and VPN drop monitoring.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "IPTracer - Network Inspector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "scripts": [
      "background/service-worker.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://ipapi.co/*",
    "https://ipinfo.io/*",
    "https://api.ipify.org/*",
    "https://cloudflare-dns.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "iptracer@extension.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
